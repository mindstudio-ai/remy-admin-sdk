{
  "name": "@madewithremy/admin",
  "version": "0.1.26",
  "description": "Admin SDK + CLI for managing production Remy apps",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "remy-admin": "./dist/prod.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "npm run tsc -- --noEmit",
    "lint:fix": "prettier --write ./src",
    "prepublishOnly": "npm run build",
    "tsc": "node node_modules/@typescript/native/bin/tsc",
    "//tsc": "The native TypeScript 7 compiler by explicit path. It (typescript@7 under the @typescript/native alias) and the JS compiler API behind the `typescript` alias — which tsup's dts step needs — both declare a `tsc` bin, so node_modules/.bin/tsc is whichever npm linked last."
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "mindstudio",
    "remy",
    "admin",
    "cli"
  ],
  "homepage": "https://mindstudio.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mindstudio-ai/remy-admin-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/mindstudio-ai/remy-admin-sdk/issues"
  },
  "author": "MindStudio <support@mindstudio.ai> (https://mindstudio.ai)",
  "license": "MIT",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "json5": "^2.2.3"
  },
  "devDependencies": {
    "@types/node": "^25.3.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "prettier": "^3.8.1",
    "tsup": "^8",
    "tsx": "^4",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
